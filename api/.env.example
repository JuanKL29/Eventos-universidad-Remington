# Puerto del API
PORT=3000
NODE_ENV=development

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:4300,http://localhost:4200

# MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambia-esto
DB_NAME=eventos_uni
DB_LOGGING=false

# JWT: generar con  openssl rand -hex 48
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-48-bytes
JWT_EXPIRES_IN=8h